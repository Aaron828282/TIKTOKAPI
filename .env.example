# 海外执行节点 —— 环境变量模板
#
# 用法：复制成 .env 后填值（.env 已被 .gitignore 排除，别提交）
#   set -a; . ./.env; set +a
# 托管平台（Hostinger Web Apps）则把这些逐条填进面板的 Environment Variables。

# ============================================================================
# 必填
# ============================================================================

# 号池地址。用 IP 字面量 —— IP 不发 SNI，正好绕过阿里云对「未接入备案域名」
# 的 SNI 拦截（域名 + HTTPS 会被 ClientHello 后立刻 RST）。
RH_POOL_URL=https://39.96.66.94

# 号池 config.json 里的 agent_token，**两边必须完全一致**。
# 为空时号池会回 503 AGENT_DISABLED（它刻意 fail closed，不会退化成免鉴权）。
RH_AGENT_TOKEN=

# TikTok Creative Studio 的**广告线**登录态（号池认的就是广告线）。
#
# 怎么拿 —— 三步，别手抄（详见 README「拿会话凭据」）：
#   1) 浏览器里登录 ads.tiktok.com，打开 Creative Studio
#   2) DevTools → Network → 选任意一条 creative_bff_i18n 请求
#      → 右键 Copy → **Copy as cURL (bash)** → 粘进 curl.txt
#   3) node tools/from-curl.js --in curl.txt
#      → 写出 session.json，并打印下面要填的 base64
#
# ⚠️ 不要用 `document.cookie` 取 —— httpOnly 的 `sessionid_ads` 读不到，
#    得到的是「看着很长、其实缺关键项」的假凭据，会在出片时才炸。
#
# ⏰ 广告线 TTL 只有 **3 天**（通用线是 180 天）。换完用
#    `node preflight.js --session-only` 验一次，不花额度。
RH_SESSION_JSON=
# 或者给一个文件路径（本地调试用；托管平台没有可靠持久盘，优先上面那个）
RH_SESSION_FILE=

# ============================================================================
# 号池 TLS —— 号池 443 是 IP 自签证书，二选一
# ============================================================================

# 推荐：把号池的 /etc/nginx/certs/rh-pool-ip/fullchain.pem 放到节点上，
# 用它把身份钉死（只加密不验身份等于给中间人留门）。
# 仓库里已带一份：`certs/pool-ca.crt`（= 号池当前那张 IP 自签证书，纯公钥）。
# Docker 镜像已内置并把 RH_POOL_CA_FILE 默认指到 /app/certs/pool-ca.crt；
# 走面板直接跑 Node 的形态则填绝对路径，例如：
#   RH_POOL_CA_FILE=/app/certs/pool-ca.crt
RH_POOL_CA_FILE=certs/pool-ca.crt

# 最后手段：完全不校验证书。仅临时联调，生产不要开。
RH_POOL_INSECURE=

# ============================================================================
# 运行参数（一般不用改）
# ============================================================================

# 平台注入的监听端口；本地默认 8080
PORT=8080
HOST=0.0.0.0

# 节点标识，进号池控制台的在线看板。默认取主机名。
RH_AGENT_ID=
RH_BACKENDS=tiktok_r2v

# 空闲时的取活间隔（秒）。同时也是「进程还活着」的心跳证据 ——
# 停掉的话号池控制台会误报离线。
RH_POLL_SECONDS=8
# 任务执行期间的心跳间隔（秒）。号池 agent_timeout 默认 900s，30s 足够。
# 但状态变化会无视节流立刻上报，免得看板上看不出「在跑」还是「挂了」。
RH_HEARTBEAT_SECONDS=30
# 单任务本地执行上限（秒）。执行期间持续打心跳，所以可以比 agent_timeout 长。
RH_JOB_TIMEOUT_SECONDS=1500
# 轮询期间「问一句这活还要不要」的间隔（秒）。
# ⚠️ 号池 heartbeat 回的 `cancelled` 是**硬编码 false 的桩**，真正的取消判定
#    在 GET /api/v1/agent/task/{id}。设成 0 就关掉这次询问 —— 代价是控制台
#    取消了任务，节点仍会跑到底，白烧一次上游额度（结果会被丢弃，不出错）。
RH_PEEK_SECONDS=20
RH_LOG_LEVEL=info

# ============================================================================
# 成品交付
# ============================================================================
#
# ⚠️ 默认是 mirror，而且**不要改回 cdn** —— 见 README「成品回传」。
#    cdn 回报的是 TikTok CDN 直链，下游（生视频网站）三道门一条都过不去：
#      ① 归档域名白名单里没有 tiktokcdn-row.com；
#      ② 归档不带 Referer → TikTok 必 403；
#      ③ MainUrl 带小时级的 UrlExpire，而归档有重试。
#    所以 mirror 不是优化，是唯一可行解。
RH_OUTPUT_MODE=mirror

# RH_OUTPUT_MODE=mirror 时必填：收件端 URL（网站侧新增的专用令牌端点）。
#
# 契约（**别再指向号池的 /api/v1/upload** —— 那是 multipart 图片口，收不了 mp4）：
#   · POST 原始视频字节流，Content-Type: video/mp4
#   · 头 X-Relay-Task-Id = **号池任务号**（= 网站 generation_jobs.upstream_task_id）
#     收件方据此反查归属；文件名只是兜底（中间层可能改写）
#   · 响应 200 + {"url":"..."} / {"output_url":"..."} / 纯文本 URL
#   · 收件方**自己决定落点**，上传方不指定存储路径
RH_MIRROR_URL=
# 可选：收件端要求的令牌（若它按令牌而非任务号鉴权）
RH_MIRROR_TOKEN=

# 收件端的体积闸门。网站侧是 25MB，这里留 1MB 余量，超了就地报错而不是传一半被 413。
# 实测成片 0.26–1.89MB（短测试）；15s / 1080P 会明显更大，真超了要同步抬两边的上限。
RH_MIRROR_MAX_MB=24
# 单次转存的超时（秒）
RH_MIRROR_TIMEOUT_SECONDS=300

# ============================================================================
# TikTok 上游常量（抓到新口径前不要动）
# ============================================================================

RH_CDN_HOST=https://p19-creative-tool-sg.ibyteimg.com
RH_SERVICE_ID=n2703mo9gi
RH_REFERER=https://ads.tiktok.com/creative/creativestudio/image-to-video
RH_ORIGIN=https://ads.tiktok.com

# ============================================================================
# 仅用于本机调试
# ============================================================================

# preflight.js 的出网代理（生产节点直连，留空）
# PREFLIGHT_PROXY=http://127.0.0.1:7890
